{
  "name": "transform-text-extension",
  "version": "1.2.0",
  "description": "Adds text transformation options to the context menu.",
  "homepage": "https://github.com/Karl-Horning/transform-text-extension#readme",
  "bugs": {
    "url": "https://github.com/Karl-Horning/transform-text-extension/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karl-Horning/transform-text-extension.git"
  },
  "type": "module",
  "license": "MIT",
  "author": "Karl Horning",
  "scripts": {
    "build": "node build.js",
    "docs:serve": "python3 -m http.server 8000 --directory docs",
    "lint": "eslint .",
    "package": "npm run build && node scripts/package-extension.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.38",
    "@types/node": "^26.2.0",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitest/coverage-v8": "^4.1.1",
    "archiver": "^8.0.0",
    "axe-core": "^4.13.0",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
